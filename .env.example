# Runtime environment: development, testing, or production
CLIPSTUDIO_ENVIRONMENT=development
CLIPSTUDIO_DEBUG=false
CLIPSTUDIO_HOST=127.0.0.1
CLIPSTUDIO_PORT=8000

# Local-first defaults; replace only for an explicitly configured deployment
CLIPSTUDIO_DATABASE_URL=sqlite+aiosqlite:///./storage/clipstudio.db
CLIPSTUDIO_STORAGE_PATH=storage
CLIPSTUDIO_LOG_PATH=logs
